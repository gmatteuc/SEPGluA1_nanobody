# =============================================================
#  sep_histology — code-only repository
#  Data NEVER enters this repo. Raw data is read-only on
#  S:\ElboustaniLab\#SHARE\Data ; derived data lives in
#  D:\sep_histology\data (outside this tree).
# =============================================================

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- MATLAB autosaves & temp ----
*.asv
*.m~
*.autosave
slprj/
codegen/

# ---- Raw acquisition ----
*.czi
*.lif
*.nd2

# ---- Volumes, cohort arrays, caches ----
*.mat
*.tif
*.tiff
*.nii
*.nii.gz
*.npy
*.h5
*.hdf5

# ---- Figures & videos (regenerate from code) ----
*.fig
*.mp4
*.avi
*.png
*.PNG
*.jpg
*.jpeg
*.pdf
*.svg

# ---- Result tables ----
*.csv

# ---- Accidental local data dirs (anchored: a folder of that name deeper in
# the code, e.g. a package's data/, is not a data dir) ----
/data/
/output/
/comparisons/

# =============================================================
#  Exceptions: vendored third-party deps ship legitimate
#  resources (colormaps, example volumes, mex binaries) that
#  the pipeline needs at runtime. Re-include their whole trees
#  (all in third_party/), the images the documentation shows,
#  the documents with their tables, the cohort table that
#  MATLAB and Python read, and the Python route's hand-written
#  gene panel.
# =============================================================
!third_party/**
!assets/**
!docs/**
!common/cohort.csv
!mapping/gene_targets.csv

# ---- Re-apply junk rules inside the vendored trees ----
**/*.asv
**/*.m~
**/.DS_Store

# =============================================================
#  Duplicate vendored copy, byte-identical to its parent and
#  deleted on 4 October 2026. Kept as a guard: if it came back,
#  genpath() would put BOTH copies on the MATLAB path, shadowing
#  transformix.m et al.
# =============================================================
third_party/matlab_elastix/matlab_elastix-master/

# Python environments (tools/requirements_*.txt recreates them) and caches
tools/venv_atlas/
tools/venv_flat/
tools/venv_dev/
__pycache__/
.ruff_cache/
